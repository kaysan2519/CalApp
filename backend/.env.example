# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cal_dev
TEST_DB_NAME=cal_test

# Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional AI Providers (Fill to enable live AI integration)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Mailer Defaults
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAILER_DRIVER=log
