# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cal_dev
TEST_DB_NAME=cal_test

# Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional live AI integration (production provider currently supported: OpenAI)
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Storage & Mailer Defaults
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAILER_DRIVER=log
